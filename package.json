{
  "name": "iris-afterimage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Iris: Afterimage — an interactive black-and-white darkroom. An experiment in light, time, and memory.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
